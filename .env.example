# ─── Supabase ────────────────────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard → your project → Settings → API

# Public anon key — safe to expose in the browser
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — SERVER ONLY. Never prefix with NEXT_PUBLIC_.
# Used exclusively in server actions and route handlers.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Site ─────────────────────────────────────────────────────────────────────
# Full URL of the deployed site (used for metadataBase and Open Graph tags)
# Example: https://astrojyotish.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
