# ─── Supabase ────────────────────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard → your project → Settings → API

# Public anon key — safe to expose in the browser
NEXT_PUBLIC_SUPABASE_URL=https://gaxqezogbosgyfbybimi.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_G_dN_PibF3Ri1u3SytPV_Q_0_ZJdAxE

